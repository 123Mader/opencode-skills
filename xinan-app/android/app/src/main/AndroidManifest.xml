<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 权限: 摄像头(视频微表情) / 网络(模型下载) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 摄像头特性 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".XinanApp"
        android:label="心安"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Xinan"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- 主界面: 双模式(聊天/视频) · 启动器, 打开即用, 无需登录 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 模型管理 -->
        <activity
            android:name=".llm.ModelManageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 成长报告 -->
        <activity
            android:name=".report.GrowthReportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 正念呼吸引导 -->
        <activity
            android:name=".relax.BreathingGuideActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 隐私声明: 非医疗设备, 严重情况引导就医 -->

    </application>
</manifest>
