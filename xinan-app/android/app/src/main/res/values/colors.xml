<?xml version="1.0" encoding="utf-8"?>
<!--
  「心安」Material 3 配色 — 平静薄荷 / 海雾 系
  参考: Google "Now in Android" (github.com/android/nowinandroid) 的 M3 tonal token 方案。
  主色取薄荷青 — 心理健康类 App 用低饱和冷色, 降低视觉唤醒。
  注: md_* 基础名在 values-night/colors.xml 中被同色系暗色覆盖, 由 Theme.Material3.DayNight 自动切换。
-->
<resources>

    <!-- ============ M3 基础色 (Light, 夜间在 values-night 覆盖) ============ -->
    <color name="md_primary">#3B6B6B</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#B6ECE6</color>
    <color name="md_on_primary_container">#00201F</color>

    <color name="md_secondary">#4A6363</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#CDE8E2</color>
    <color name="md_on_secondary_container">#051F1F</color>

    <color name="md_tertiary">#486079</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#D5E4FF</color>
    <color name="md_on_tertiary_container">#001D33</color>

    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <color name="md_background">#F5FBF9</color>
    <color name="md_on_background">#191C1C</color>
    <color name="md_surface">#F5FBF9</color>
    <color name="md_on_surface">#191C1C</color>
    <color name="md_surface_variant">#DAE5E2</color>
    <color name="md_on_surface_variant">#3F4948</color>

    <color name="md_outline">#6F7978</color>
    <color name="md_outline_variant">#BEC9C6</color>

    <!-- ============ 仪表盘语义色 (叠加在深色摄像头预览上, 不随主题翻转) ============ -->
    <color name="emotion_calm">#4CAF50</color>      <!-- 平静 绿 -->
    <color name="emotion_tense">#FFC107</color>     <!-- 紧张 黄 -->
    <color name="emotion_anxiety">#FF7043</color>    <!-- 焦虑 橙红 -->
    <color name="emotion_high">#E53935</color>      <!-- 高焦虑 红 -->
    <color name="emotion_joy">#26A69A</color>       <!-- 快乐 青 -->
    <color name="emotion_sad">#5C6BC0</color>       <!-- 悲伤 靛 -->
    <color name="overlay_scrim">#99000000</color>  <!-- 仪表盘半透明底 -->

    <!-- ============ 兼容旧引用 ============ -->
    <color name="xinan_bg">@color/md_surface</color>
    <color name="xinan_primary">@color/md_primary</color>
    <color name="white">#FFFFFF</color>
</resources>
