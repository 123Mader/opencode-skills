<?xml version="1.0" encoding="utf-8"?>
<!--
  「心安」主界面 — 最稳版 (M3 主题渐变 + 纯 LinearLayout/Button, 去掉可能 inflate 崩的 toggle group/toolbar menu)
  保留 view-binding ID: fragmentContainer / btnChatMode / btnVideoMode
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 标题 (windowBackground 渐变透出, 不用 MaterialToolbar 避免 menu/logo inflate 风险) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="心安"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center" />

    <!-- 内容区 (聊天/视频 Fragment) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部双模式切换 (普通 Button, M3 主题自动样式) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnChatMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬 聊天" />

        <Button
            android:id="@+id/btnVideoMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📹 视频" />
    </LinearLayout>

</LinearLayout>
